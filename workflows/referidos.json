    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "056c1ffc-1573-49c5-a273-88299a0ddf4c",
              "name": "Mensaje",
              "value": "={{ (() => {\n  // Obtenemos el teléfono desde el nodo 'Referidos' y nos aseguramos de que sea texto\n  const rawPhone = $('Referidos').item.json.body.whatsapp_phone;\n  const phone = rawPhone ? rawPhone.toString() : '';\n  \n  // Obtenemos la URL del nodo actual\n  const url = $json.data.referral_link || '';\n  \n  // Definimos el monto por defecto (Perú)\n  let monto = 'S/15.5'; \n  \n  // Evaluamos el código de país en el teléfono\n  if (phone.startsWith('+51') || phone.startsWith('51')) {\n    monto = 'S/15.5';\n  } else if (phone.startsWith('+52') || phone.startsWith('52')) { // Cubre +52 y +521\n    monto = '$99';\n  } else if (phone.startsWith('+57') || phone.startsWith('57')) {\n    monto = '$15500';\n  }\n  \n  // Retornamos el mensaje dinámico completo\n  return `¡Te regalo ${monto} para que pidas tu primera comida en Manzana Verde! 🎁  ¿Listo para comer rico y sano?🥙😍 ¡Regístrate para obtener tu recomendación nutricional y pide tu primera comida totalmente gratis! ${url} Recuerda que este link es exclusivo para ti, válido a través de nuestra app. 🍏`;\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -576,
        -320
      ],
      "id": "87fc41cd-8303-46c7-8f8f-ee411cb27856",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.manychat.com/fb/sending/sendContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"subscriber_id\": \"{{ $('Referidos').item.json.body.id }}\",\n  \"data\": {\n    \"version\": \"v2\",\n    \"content\": {\n      \"type\": \"whatsapp\",\n      \"messages\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"{{ $json.Mensaje }}\"\n        }\n      ]\n    }\n  }\n}",
        "options": {}
      },
