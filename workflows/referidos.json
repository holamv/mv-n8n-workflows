              "value": "={{ $('Referidos').item.json.body.whatsapp_phone?.startsWith('+521') ? $('Referidos').item.json.body.whatsapp_phone.slice(4) : $('Referidos').item.json.body.whatsapp_phone?.slice(3) }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
